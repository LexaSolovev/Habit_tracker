# Django
SECRET_KEY=your-production-secret-key-change-this
DEBUG=False
ALLOWED_HOSTS=your_ip,localhost

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=habit_tracker
DB_USER=habit_user
DB_PASSWORD=your_production_db_password
DB_HOST=postgres
DB_PORT=5432

# Redis
REDIS_URL=redis://:your_production_redis_password@redis:6379/0
REDIS_PASSWORD=your_production_redis_password

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Celery
CELERY_BROKER_URL=redis://:your_production_redis_password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:your_production_redis_password@redis:6379/0